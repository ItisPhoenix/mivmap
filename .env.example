# Mivmap local configuration — copy to .env and keep it private.
# The .env file is gitignored. Never commit real keys.

# Local server binding (keep on loopback unless you know what you are doing)
HOST=127.0.0.1
PORT=8765
# Optional: additional exact chrome-extension:// origins allowed to call the
# backend (comma separated). A fresh unpacked install has its own ID; register
# it with `python scripts/register_extension.py <id>` instead of editing source.
# Wildcards are never accepted. Leave empty if you only use the built-in IDs.
CORS_ORIGINS=

# --- Primary LLM: any OpenAI chat-completions-compatible provider -----------
# Works with OpenAI, NVIDIA NIM, Kilo gateway, Together, vLLM, Ollama, etc.
# Leave LLM_API_KEY empty for the free, fully offline heuristic pipeline.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# --- Optional fallbacks / extra capabilities --------------------------------
# Groq remains supported as an optional fallback for refine/chat.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
GROQ_LABEL_MODEL=

# Hugging Face Inference Providers fallback, or a fully local model.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_LOCAL_MODEL=

# English-only maps: translate non-English transcripts once with NLLB-200.
NLLB_ENABLED=1
# NLLB_MODEL_PATH=

# --- Embeddings: pick one mode; remote takes priority -----------------------
# Remote: endpoint + model identifier (any compatible embeddings API).
# EMBEDDING_BASE_URL is the service root (e.g. https://your-host[:port]); a
# trailing /v1 is also accepted. The embedding path is appended exactly once.
# Leave EMBEDDING_API_KEY empty when the endpoint needs no authentication.
# EMBEDDING_BASE_URL=
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# HTTPX per-phase timeout in seconds (connect, read, write and pool each get
# this value). It is not a total deadline for the entire request.
# EMBEDDING_TIMEOUT=60
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_CACHE_DIR=
#
# Local: used only when EMBEDDING_BASE_URL is empty. Leave the model empty to
# reuse a single, already-cached compatible model (nothing is ever downloaded).
# EMBEDDING_LOCAL_MODEL=
#
# If neither mode is available, the backend uses TF-IDF/LSA automatically.

# Optional heavy extras (install backend/requirements-ml.txt to use them).
# WHISPER_MODEL=base

# Hard deadlines in seconds for the map-label and chat calls.
LABEL_TIMEOUT=1.2
CHAT_TIMEOUT=12.0

# Optional Notion export.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
